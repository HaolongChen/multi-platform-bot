{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn"],
  "rules": {
    "typescript/no-explicit-any": "warn",
    "typescript/no-floating-promises": "error"
  },
  "env": {
    "node": true
  },
  "ignorePatterns": ["node_modules", "dist", "build"]
}
